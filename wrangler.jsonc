{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-apps",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "72919465-4497-46cb-8d38-0f4fcec6d090","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f58b1d8954b54058bd60e77da55f7ecd" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
